<?xml version="1.0" encoding="utf-8"?>
<!--
	Template for ConnectionStrings.config
	Copy this file and rename it to "ConnectionStrings.config" — do NOT commit that file.

	LOCAL SETUP (SQL Server Express - free):
	1. Install SQL Server Express from https://www.microsoft.com/en-us/sql-server/sql-server-downloads
	2. Open SSMS, connect to .\SQLEXPRESS with Windows Authentication
	3. Run the FreeHubDB.sql script from the Database folder
	4. Copy this file to ConnectionStrings.config — it will work as-is
-->
<connectionStrings>
	<add name="FreeHubDB"
		 connectionString="Server=.\SQLEXPRESS;Initial Catalog=FreeHubDB;Integrated Security=True;TrustServerCertificate=True;Encrypt=False;Connection Timeout=30;"
		 providerName="System.Data.SqlClient" />
</connectionStrings>
